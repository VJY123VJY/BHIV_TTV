# ==============================================================================
# UNIFIED TEXT-TO-VIDEO (TTV) SYSTEM CONFIGURATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security & Governance (From ttv7, ttv11, Text_to_vision2)
GOVERNANCE_LOCK=ON
WRAPPER_TOKEN=TTV_SECURE_GOVERNED_TOKEN_2026

# Provider Selection (Options: openai | gemini | local)
LLM_PROVIDER=local

# Image Generation Provider (Options: openai | local)
IMAGE_PROVIDER=local

# Video Generation Engine (Options: opencv | external | wan)
# opencv  — local cinematic engine, no GPU required (default/safe)
# external — falls back to opencv
# wan     — Wan 2.2 TI2V-5B on cloud NVIDIA GPU (requires CUDA)
VIDEO_PROVIDER=opencv

# ── Wan 2.2 TI2V-5B Video Generation (cloud NVIDIA GPU only) ─────────────────
# Prerequisites:
#   1. NVIDIA GPU with CUDA (≥16GB VRAM for 480p, ≥24GB for 720p)
#   2. Install torch for your CUDA version: https://pytorch.org/get-started/locally/
#   3. pip install diffusers>=0.33.0 transformers>=4.51.0 accelerate>=1.6.0
#
# WAN_MODEL_ID=Wan-AI/Wan2.2-TI2V-5B-Diffusers
# WAN_DEVICE=cuda
# WAN_DTYPE=bfloat16           # bfloat16 (A100/H100) | float16 (T4/V100)
# WAN_NUM_FRAMES=81            # Frames Wan generates per clip
# WAN_INFERENCE_STEPS=30       # Diffusion steps (higher = better quality, slower)
# WAN_GUIDANCE_SCALE=5.0       # CFG scale
# HF_TOKEN=                    # HuggingFace token if model access is gated


# Text-to-Speech Provider (Options: edgetts | gtts | local)
TTS_PROVIDER=local

# Visual Consistency & Style Engine (Options: standard | enhanced)
VISION_PROVIDER=standard

# API Keys (Optional - required only if cloud providers are enabled)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Paths
OUTPUT_DIR=generated/videos
TEMP_DIR=generated/temp
IMAGES_DIR=generated/images
SCENES_DIR=generated/scenes
AUDIO_DIR=generated/audio

# Generation Defaults
DEFAULT_DURATION=15
MAX_DURATION=60
DEFAULT_FPS=24
DEFAULT_RESOLUTION=1280x720
DEFAULT_STYLE=cinematic
DEFAULT_VOICE=en-US-GuyNeural

# Audio Mixing Defaults
BACKGROUND_MUSIC_ENABLED=true
AUDIO_DUCKING_RATIO=0.3
AUDIO_SAMPLE_RATE=44100
